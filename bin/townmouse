#!/usr/bin/env node
'use strict';
const { spawn } = require('child_process');
const path = require('path');
const pkg = require('../package.json');

const ROOT = path.join(__dirname, '..');
let port = Number(process.env.PORT) || 11001;
let openBrowser = true;

for (let i = 0; i < process.argv.length; i++) {
  const arg = process.argv[i];
  if (arg === '--help' || arg === '-h') {
    console.log(`Townmouse ${pkg.version}

Usage: townmouse [--port <n>] [--no-open]

  --port <n>   Port for the local server (default 11001)
  --no-open    Do not open a browser window
`);
    process.exit(0);
  }
  if (arg === '--version' || arg === '-v') {
    console.log(pkg.version);
    process.exit(0);
  }
  if (arg === '--no-open') {
    openBrowser = false;
  } else if (arg === '--port' && process.argv[i + 1]) {
    port = Number(process.argv[++i]);
  } else if (arg.startsWith('--port=')) {
    port = Number(arg.slice('--port='.length));
  }
}

if (!Number.isInteger(port) || port < 1 || port > 65535) {
  console.error('townmouse: invalid port');
  process.exit(2);
}

const url = `http://127.0.0.1:${port}/`;
const child = spawn(process.execPath, [path.join(ROOT, 'src', 'server.js')], {
  cwd: ROOT,
  env: { ...process.env, PORT: String(port) },
  stdio: 'inherit'
});

if (openBrowser) {
  setTimeout(() => {
    if (process.platform === 'darwin') {
      spawn('open', [url], { stdio: 'ignore', detached: true }).unref();
    } else if (process.platform === 'win32') {
      spawn('cmd', ['/c', 'start', '', url], { stdio: 'ignore', detached: true }).unref();
    } else {
      spawn('xdg-open', [url], { stdio: 'ignore', detached: true }).unref();
    }
  }, 900).unref();
}

const stop = (signal) => {
  try { child.kill(signal); } catch (_) { /* already gone */ }
};
process.on('SIGINT', () => stop('SIGINT'));
process.on('SIGTERM', () => stop('SIGTERM'));
child.on('exit', (code, signal) => {
  if (signal) process.kill(process.pid, signal);
  else process.exit(code == null ? 0 : code);
});
